{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "noEmit": true,
    "rootDir": ".",
    "jsx": "react-jsx",
    "module": "ESNext",
    "moduleResolution": "Bundler"
  },
  "include": ["src/**/*.ts", "test/**/*.ts", "test/**/*.tsx", "scripts/**/*.ts", "formal/**/*.ts"],
  "exclude": ["node_modules", "dist"]
}
