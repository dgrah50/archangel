# Target repository
ARCHANGEL_GITHUB_OWNER=dgrah50
ARCHANGEL_GITHUB_REPO=gijq
ARCHANGEL_DEFAULT_BRANCH=main
# Your numeric GitHub user ID (find via: gh api user --jq .id)
ARCHANGEL_OWNER_USER_ID=

# Dedicated GitHub App (NO fine-grained PAT; grant contents:write, pull_requests:write,
# issues:write, checks:read — NO workflows, NO administration, NO checks:write)
ARCHANGEL_GITHUB_APP_ID=
ARCHANGEL_GITHUB_INSTALLATION_ID=
ARCHANGEL_GITHUB_PRIVATE_KEY_PEM="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# Metered API keys (ToS-safe; separate Anthropic key with low cap recommended for worker)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional dedicated macOS user for OS-level credential isolation (ADR-0004)
# ARCHANGEL_WORKER_USER=archangel-worker

# Bounds & Shadow Mode
ARCHANGEL_SHADOW_MODE=true
ARCHANGEL_MAX_CONCURRENT=2
ARCHANGEL_MAX_DAILY_USD=20
ARCHANGEL_MAX_MERGES_PER_DAY=3
ARCHANGEL_TIMEZONE=America/New_York
ARCHANGEL_POLL_MS=30000

# Optional Telegram Needs You notifications
# ARCHANGEL_TELEGRAM_BOT_TOKEN=
# ARCHANGEL_TELEGRAM_CHAT_ID=

# Optional Paseo daemon endpoint for Handoff
# PASEO_HOST=127.0.0.1:6767
