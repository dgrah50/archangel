# Secrets only — non-secret project & gate policy lives in archangel.yaml
# (If no archangel.yaml exists, single-repo env vars below also work as fallback.)

# Dedicated GitHub App (NO fine-grained PAT; grant contents:write, pull_requests:write,
# issues:write, checks:read — NO workflows, NO administration, NO checks:write)
ARCHANGEL_GITHUB_APP_ID=
ARCHANGEL_GITHUB_INSTALLATION_ID=
# Numeric user id of the App's bot account (<app-slug>[bot]); required when scouts.enabled.
# scripts/create-github-app.ts fills this and the installation id in after you install the App.
ARCHANGEL_GITHUB_BOT_USER_ID=
# Prefer pointing to a local chmod 600 PEM file (takes precedence over inline PEM):
ARCHANGEL_GITHUB_PRIVATE_KEY_PATH=~/.config/archangel/github-app.pem
# Or inline escaped PEM:
# ARCHANGEL_GITHUB_PRIVATE_KEY_PEM="-----BEGIN RSA PRIVATE KEY-----\n...\n-----END RSA PRIVATE KEY-----"

# Metered API keys (ToS-safe)
ANTHROPIC_API_KEY=
OPENAI_API_KEY=
GOOGLE_GENERATIVE_AI_API_KEY=

# Optional Telegram Needs You notifications
# ARCHANGEL_TELEGRAM_BOT_TOKEN=
# ARCHANGEL_TELEGRAM_CHAT_ID=

# Single-repo fallback (only needed if not using archangel.yaml)
# ARCHANGEL_OWNER_USER_ID=
# ARCHANGEL_GITHUB_OWNER=owner
# ARCHANGEL_GITHUB_REPO=my-repo
# ARCHANGEL_SHADOW_MODE=true
