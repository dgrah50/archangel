{
  "version": 1,
  "gate": {
    "testFileGlobs": [
      "test/**/*.test.ts"
    ],
    "testBuildCmd": "bun run typecheck",
    "baseTestCmd": "bun test --parallel --timeout=30000",
    "testCmd": "bun run test:all",
    "protectedPaths": [
      "package.json",
      "bun.lock",
      "tsconfig.json",
      "tsconfig.test.json",
      "src/config.ts",
      "src/env.ts",
      "src/gate/**",
      "src/broker/**",
      "src/agents/**",
      "src/github/**",
      "src/ledger/**",
      "src/cli/**",
      "src/core/blockers.ts",
      "src/core/thread-machine.ts",
      "src/core/reconciler.ts",
      "src/core/scout.ts",
      "src/core/spawn-group.ts",
      "src/compute/**",
      "templates/**",
      "workflows/**",
      "formal/**",
      "scripts/lint.ts",
      "src/core/json.ts",
      "bin/**",
      "skills/**",
      "src/core/work-class.ts",
      "src/core/onboard.ts",
      "src/core/bump.ts",
      "src/core/pitch-promote.ts",
      "src/core/owner-reply.ts",
      "src/core/metrics-block.ts",
      "src/core/skills.ts",
      "src/core/fleet-scouts.ts",
      "src/core/fleet-miner.ts",
      "src/core/ui-server.ts",
      "src/core/ui-pitches.ts",
      "ui/**",
      "src/core/workflow.ts",
      "src/core/workflow-load.ts",
      "src/core/gate-pin.ts",
      "src/core/workflow-propose.ts",
      "src/core/ui-propose.ts",
      "src/core/pitch.ts",
      "test/protected-paths.test.ts",
      "src/core/failure-clusters.ts",
      "src/core/replay.ts",
      "src/core/doctor.ts",
      "src/handoff/paseo.ts",
      "src/core/notifier.ts",
      "src/core/escalations.ts",
      "src/core/pitch-expiry.ts",
      "src/core/command-machine.ts",
      "src/core/corrections.ts",
      "src/core/pitch-machine.ts",
      "src/core/correction-draft.ts",
      "src/core/triage.ts",
      "src/core/factory-retry.ts",
      "src/core/eval.ts",
      "src/core/eval-candidate.ts",
      "src/core/bench-tiers.ts",
      "src/core/attempt-input.ts",
      "src/core/ui-thread.ts",
      "src/core/host-facts.ts",
      "src/core/ui-doctor.ts",
      "src/core/ui-settings.ts",
      "src/core/accounts.ts",
      "src/core/eval-reports.ts",
      "src/core/ui-host-config.ts",
      "src/core/ui-onboard.ts",
      "src/core/ui-gh.ts",
      "src/core/ui-accounts.ts"
    ],
    "testDataGlobs": [
      "test/helpers/**"
    ]
  },
  "requiredChecks": [
    "Gate",
    "Test"
  ],
  "scouts": [
    {
      "name": "self-audit",
      "schedule": "daily",
      "maxProposals": 2,
      "includeMetrics": true,
      "skills": [
        "general/factory-signals",
        "general/bug-hunt",
        "general/error-handling",
        "typescript/async-and-promises",
        "typescript/type-holes"
      ]
    }
  ],
  "landing": {
    "bugfix": "autonomous"
  },
  "escalations": {
    "factoryRetry": "once"
  }
}
