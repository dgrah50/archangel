{
  "maxNonTestLines": 150,
  "maxTotalLines": 300,
  "maxFiles": 5,
  "testFileGlobs": [
    "test/**/*.test.ts"
  ],
  "testDataGlobs": [],
  "testBuildCmd": "npm run typecheck",
  "baseTestCmd": "npx vitest run",
  "testCmd": "npm run test:all",
  "baseTestRuns": 3,
  "headTestRuns": 2,
  "extraProtectedPaths": [
    "package.json",
    "package-lock.json",
    "tsconfig.json",
    "tsconfig.test.json",
    "vitest.config.ts",
    "src/config.ts",
    "src/env.ts",
    "src/gate/**",
    "src/broker/**",
    "src/agents/**",
    "src/github/**",
    "src/ledger/**",
    "src/cli/**",
    "src/core/blockers.ts",
    "src/core/thread-machine.ts",
    "src/core/reconciler.ts",
    "src/core/scout.ts",
    "templates/**",
    "workflows/**",
    "bin/**",
    "skills/**"
  ],
  "requiredChecks": [
    "Gate",
    "Test"
  ]
}
