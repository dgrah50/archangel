{
  "maxNonTestLines": 150,
  "maxTotalLines": 300,
  "maxFiles": 5,
  "testFileGlobs": ["**/*_test.go"],
  "testDataGlobs": ["**/testdata/**"],
  "testBuildCmd": "go test -run=^$ ./...",
  "baseTestCmd": "go test -count=1 ./...",
  "testCmd": "go test -race -count=1 ./...",
  "baseTestRuns": 3,
  "headTestRuns": 2,
  "extraProtectedPaths": [
    "go.mod",
    "go.sum",
    "go.work",
    "go.work.sum",
    "vendor/**",
    "scripts/**",
    "Makefile",
    "GNUmakefile",
    ".goreleaser*",
    ".golangci*"
  ],
  "requiredChecks": [
    "Gate",
    "Test"
  ]
}
