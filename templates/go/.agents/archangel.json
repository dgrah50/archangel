{
  "version": 1,
  "gate": {
    "testFileGlobs": ["**/*_test.go"],
    "testDataGlobs": ["**/testdata/**"],
    "testBuildCmd": "go test -run=^$ ./...",
    "baseTestCmd": "go test -count=1 ./...",
    "testCmd": "go test -race -count=1 ./...",
    "protectedPaths": [
      "go.mod",
      "go.sum",
      "go.work",
      "go.work.sum",
      "vendor/**",
      "scripts/**",
      "Makefile",
      "GNUmakefile",
      ".goreleaser*",
      ".golangci*"
    ]
  },
  "requiredChecks": ["Test"]
}
