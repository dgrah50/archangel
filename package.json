{
  "name": "archangel",
  "version": "0.1.0",
  "description": "Single-owner autonomous software factory for bugs, features, and chores with mechanical merge gates, independent cross-vendor review, and self-improving Scouts",
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/dgrah50/archangel.git"
  },
  "homepage": "https://github.com/dgrah50/archangel#readme",
  "bugs": {
    "url": "https://github.com/dgrah50/archangel/issues"
  },
  "engines": {
    "node": ">=22.0.0"
  },
  "keywords": [
    "software-factory",
    "autonomous-agents",
    "github-actions",
    "code-review",
    "merge-gate",
    "developer-tools"
  ],
  "type": "module",
  "bin": {
    "archangel": "./dist/cli/index.js"
  },
  "scripts": {
    "build": "tsc -p tsconfig.json && npm run build:gate-bundle && npm run build:ui",
    "build:gate-bundle": "esbuild src/gate/cli.ts --bundle --minify --platform=node --format=esm --banner:js=\"import { createRequire } from 'node:module'; const require = createRequire(import.meta.url);\" --outfile=bin/archangel-gate.mjs",
    "build:ui": "tsc -p ui/tsconfig.json && vite build --config ui/vite.config.ts",
    "build:all": "npm run build",
    "typecheck": "tsc -p tsconfig.test.json --noEmit",
    "lint": "tsx scripts/lint.ts",
    "verify:formal": "tsx formal/check.ts",
    "test": "bun test --parallel --timeout=30000",
    "test:all": "npm run typecheck && npm test",
    "dev": "tsx src/cli/index.ts"
  },
  "dependencies": {
    "@ai-sdk/google": "^4.0.124",
    "@ai-sdk/openai": "^4.0.122",
    "@anthropic-ai/claude-agent-sdk": "^0.3.330",
    "@getpaseo/client": "^0.16.2",
    "@mastra/core": "^1.85.0",
    "@mastra/libsql": "^1.31.1",
    "better-sqlite3": "^13.2.0",
    "commander": "^15.1.0",
    "yaml": "^2.9.1",
    "zod": "^4.6.7"
  },
  "devDependencies": {
    "@chakra-ui/react": "^3.38.0",
    "@emotion/react": "^11.14.0",
    "@fontsource-variable/geist": "^5.3.0",
    "@fontsource-variable/geist-mono": "^5.3.0",
    "@fontsource-variable/inter": "^5.3.0",
    "@types/better-sqlite3": "^9.6.0",
    "@types/bun": "^1.4.5",
    "@types/node": "^25.0.0",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^6.3.0",
    "esbuild": "^0.28.2",
    "next-themes": "^0.4.6",
    "react": "^19.3.1",
    "react-dom": "^19.3.1",
    "tsx": "^4.23.15",
    "typescript": "^7.0.2",
    "typescript-api": "npm:typescript@^5.9.3",
    "vite": "^8.3.8"
  }
}
